# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- ADB / Android device automation ---
# Path to the adb executable. Defaults to "adb" and relies on it being on PATH.
ADB_PATH=adb

# --- Persistence ---
# SQLite file path for Phase 1-11. Swappable for a PostgreSQL connection string later.
DATABASE_PATH=./data/app.db

# Directory where recording session JSON is stored (relative to backend/ by default).
RECORDINGS_DIR=../recordings

# Directory where generated Mobilewright scripts are written (relative to backend/ by default).
GENERATED_TESTS_DIR=../generated-tests

# Directories for execution reports and screenshots (relative to backend/ by default).
REPORTS_DIR=../reports
SCREENSHOTS_DIR=../screenshots

# Directory where uploaded documents for Document-to-Test are stored (relative to backend/ by default).
UPLOADS_DIR=../uploads

# --- AI service layer (Claude) ---
# Required for AI failure analysis, script fixes, and document-to-test generation.
# Never hardcode this value in source. Leave blank to disable AI features locally.
ANTHROPIC_API_KEY=

# Model used for AI features. Defaults to Anthropic's current flagship model.
ANTHROPIC_MODEL=claude-opus-5

# --- Logging ---
LOG_LEVEL=info
